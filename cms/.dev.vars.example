# Copy to .dev.vars for `bun run rss:dev`.
# Use the same CONTENT_AUTOMATION_TOKEN in cms/.env so Payload accepts Worker-created posts.
PAYLOAD_API_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:3000
CONTENT_AUTOMATION_TOKEN=change-me-local-secret
RSS_WORKER_TRIGGER_TOKEN=change-me-trigger-secret
MAX_ITEMS_PER_RUN=1
MAX_ITEMS_PER_FEED=1
