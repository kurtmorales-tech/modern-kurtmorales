# KurtMorales PayloadCMS / Next package
FROM oven/bun:1.3.13-alpine AS deps
WORKDIR /app
COPY package.json ./
COPY web/package.json ./web/package.json
COPY cms/package.json ./cms/package.json
RUN bun install

FROM deps AS build
WORKDIR /app
COPY . .
RUN bun run build:cms

FROM oven/bun:1.3.13-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/cms ./cms
EXPOSE 3001
CMD ["bun", "run", "start", "--cwd", "cms"]
