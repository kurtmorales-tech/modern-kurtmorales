---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPosts } from '../../lib/payload';
import { fallbackPosts } from '../../data/fallback';

const cmsPosts = await getPosts();
const posts = cmsPosts.length > 0 ? cmsPosts : fallbackPosts;
---
<BaseLayout title="Blog — KurtMorales" description="Thoughts on web development, freelancing, AI integration, and building for the modern web.">
  <Header />
  <main class="pt-12 pb-32">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-20">
        <span class="text-gray-400 font-bold text-[10px] tracking-widest uppercase block mb-6">Blog</span>
        <h1 class="text-4xl md:text-6xl font-display font-medium leading-tight text-brand mb-6">
          Writing & insights.
        </h1>
        <p class="text-gray-500 text-lg leading-relaxed">
          Notes on web development, freelancing, AI, and building for the modern web.
        </p>
      </div>

      {posts.length === 0 ? (
        <p class="text-gray-400 text-center py-20">No posts yet. Check back soon.</p>
      ) : (
        <div class="grid gap-px bg-gray-200 border border-gray-200 overflow-hidden">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class="block bg-white p-10 md:p-14 hover:bg-gray-50 transition-colors group">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
                <div class="flex-1">
                  <div class="flex flex-wrap gap-3 mb-4">
                    {post.tags?.map((t) => (
                      <span class="text-[9px] font-black uppercase tracking-widest text-gray-400 border border-gray-200 px-3 py-1">
                        {t.tag}
                      </span>
                    ))}
                  </div>
                  <h2 class="text-xl md:text-2xl font-bold text-black tracking-tight mb-3 group-hover:text-brand transition-colors">
                    {post.title}
                  </h2>
                  <p class="text-gray-500 text-sm leading-relaxed max-w-2xl">{post.excerpt}</p>
                </div>
                <div class="flex items-center gap-6 text-[10px] font-black uppercase tracking-widest text-gray-400 shrink-0 md:pt-2">
                  <time datetime={post.date}>
                    {new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </time>
                  {post.readTime && <span>{post.readTime}</span>}
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>
