---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPosts, getPostBySlug } from '../../lib/payload';
import { fallbackPosts } from '../../data/fallback';
import { markdownToHtml } from '../../lib/markdown';

export async function getStaticPaths() {
  const cmsPosts = await getPosts();
  const posts = cmsPosts.length > 0 ? cmsPosts : fallbackPosts;
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const cmsPost = await getPostBySlug(slug!);
const post = cmsPost || fallbackPosts.find((p) => p.slug === slug);

if (!post) return Astro.redirect('/blog');

const htmlContent = post.contentMarkdown ? markdownToHtml(post.contentMarkdown) : '';
---
<BaseLayout title={`${post.title} — KurtMorales`} description={post.excerpt}>
  <Header />
  <main class="pt-12 pb-32">
    <article class="max-w-3xl mx-auto px-6">
      <a href="/blog" class="inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-gray-400 hover:text-brand transition-colors mb-12">
        <svg class="w-3 h-3 rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/></svg>
        Back to Blog
      </a>

      <header class="mb-16">
        <div class="flex flex-wrap gap-3 mb-6">
          {post.tags?.map((t) => (
            <span class="text-[9px] font-black uppercase tracking-widest text-gray-400 border border-gray-200 px-3 py-1">
              {t.tag}
            </span>
          ))}
        </div>
        <h1 class="text-3xl md:text-5xl font-display font-medium leading-tight text-brand mb-6">
          {post.title}
        </h1>
        <p class="text-gray-500 text-lg leading-relaxed mb-8">{post.excerpt}</p>
        <div class="flex items-center gap-6 text-[10px] font-black uppercase tracking-widest text-gray-400 border-t border-gray-100 pt-6">
          <time datetime={post.date}>
            {new Date(post.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </time>
          {post.readTime && <span>{post.readTime}</span>}
        </div>
      </header>

      <div class="prose prose-gray max-w-none prose-headings:font-display prose-headings:text-brand prose-a:text-brand prose-a:no-underline hover:prose-a:underline prose-code:text-sm prose-pre:bg-gray-950 prose-pre:text-gray-100" set:html={htmlContent} />

      <footer class="mt-20 pt-10 border-t border-gray-100">
        <a href="/blog" class="inline-flex items-center gap-3 px-8 py-4 border border-brand text-brand font-bold hover:bg-brand hover:text-white transition-all active:scale-95">
          <svg class="w-3 h-3 rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/></svg>
          More Articles
        </a>
      </footer>
    </article>
  </main>
  <Footer />
</BaseLayout>
