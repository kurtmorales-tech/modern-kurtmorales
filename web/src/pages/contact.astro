---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const backendUrl = (
  import.meta.env.PUBLIC_BACKEND_URL ||
  'http://localhost:3001'
).replace(/\/$/, '');
---
<BaseLayout
  title="Contact — KurtMorales"
  description="Get in touch with KurtMorales. Ready to start a web design project in Las Vegas or remotely? Let's talk."
>
  <Header />
  <main id="main-content">
    <section class="pt-32 pb-24 border-b border-gray-100">
      <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-[1fr_1.2fr] gap-20 items-start">

        <!-- Left: Info -->
        <div>
          <span class="text-gray-400 font-bold text-[10px] tracking-widest uppercase block mb-6 reveal">Contact</span>
          <h1 class="text-4xl md:text-6xl font-display font-medium leading-tight text-brand mb-8 reveal" style="transition-delay:100ms">
            Let's build something great.
          </h1>
          <p class="text-gray-500 leading-relaxed mb-12 reveal" style="transition-delay:200ms">
            Have a project in mind? Reach out with your idea, timeline, and budget — I'll get back to you within 24 hours.
          </p>
          <ul class="space-y-6 reveal" style="transition-delay:300ms">
            {[
              { label: 'Email', value: 'email@kurtmorales.com', href: 'mailto:email@kurtmorales.com' },
              { label: 'LinkedIn', value: 'kurtanthonymorales', href: 'https://www.linkedin.com/in/kurtanthonymorales/' },
              { label: 'GitHub', value: 'kurtmorales-tech', href: 'https://github.com/kurtmorales-tech' },
            ].map(item => (
              <li class="group flex items-center gap-4">
                <span class="text-[9px] font-black uppercase tracking-widest text-gray-400 w-16 shrink-0">{item.label}</span>
                <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer"
                  class="text-sm font-bold text-black group-hover:text-brand transition-colors link-underline">
                  {item.value}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Right: Form -->
        <div class="reveal-right bg-white border border-gray-200 p-10 relative">
          <div class="absolute top-0 left-0 w-12 h-[2px] bg-brand"></div>
          <div class="absolute top-0 left-0 w-[2px] h-12 bg-brand"></div>

          <form id="contact-form" class="space-y-6" data-api-base={backendUrl}>
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-[9px] font-black uppercase tracking-widest text-gray-500 mb-2">Name *</label>
                <input type="text" id="name" name="name" required
                  class="w-full border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:border-brand transition-colors bg-white"
                  placeholder="Your name" />
              </div>
              <div>
                <label for="email" class="block text-[9px] font-black uppercase tracking-widest text-gray-500 mb-2">Email *</label>
                <input type="email" id="email" name="email" required
                  class="w-full border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:border-brand transition-colors bg-white"
                  placeholder="your@email.com" />
              </div>
            </div>

            <div>
              <label for="project" class="block text-[9px] font-black uppercase tracking-widest text-gray-500 mb-2">Project Type</label>
              <select id="project" name="project"
                class="w-full border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:border-brand transition-colors bg-white text-gray-700">
                <option value="">Select a service...</option>
                <option value="brand-website">Brand Website</option>
                <option value="landing-page">Landing / Conversion Page</option>
                <option value="custom-tool">Custom Tool / Dashboard</option>
                <option value="ecommerce">E-commerce</option>
                <option value="other">Other / Not sure</option>
              </select>
            </div>

            <div>
              <label for="budget" class="block text-[9px] font-black uppercase tracking-widest text-gray-500 mb-2">Budget Range</label>
              <select id="budget" name="budget"
                class="w-full border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:border-brand transition-colors bg-white text-gray-700">
                <option value="">Select a range...</option>
                <option value="under-1k">Under $1,000</option>
                <option value="1k-3k">$1,000 – $3,000</option>
                <option value="3k-7k">$3,000 – $7,000</option>
                <option value="7k-plus">$7,000+</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-[9px] font-black uppercase tracking-widest text-gray-500 mb-2">Message *</label>
              <textarea id="message" name="message" rows="5" required
                class="w-full border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:border-brand transition-colors bg-white resize-none"
                placeholder="Describe your project, goals, and timeline..."></textarea>
            </div>

            <!-- Status messages -->
            <div id="form-success" class="hidden p-4 bg-green-50 border border-green-200 text-green-700 text-sm font-medium">
              ✅ Message sent! I'll get back to you within 24 hours.
            </div>
            <div id="form-error" class="hidden p-4 bg-red-50 border border-red-200 text-red-700 text-sm font-medium">
              ❌ Something went wrong. Please email me directly at email@kurtmorales.com
            </div>

            <button type="submit" id="submit-btn"
              class="group w-full flex items-center justify-center gap-3 px-10 py-5 bg-brand text-white font-bold hover:bg-brand-dark transition-all duration-300 active:scale-[0.98]">
              <span id="btn-text">Send Message</span>
              <svg id="btn-icon" class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/></svg>
              <svg id="btn-spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
            </button>
          </form>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Scroll reveal
  const obs = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); obs.unobserve(e.target); } }),
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => obs.observe(el));

  // Form submit
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const apiBase = form.dataset.apiBase || '';
  const btnText = document.getElementById('btn-text')!;
  const btnIcon = document.getElementById('btn-icon')!;
  const btnSpinner = document.getElementById('btn-spinner')!;
  const success = document.getElementById('form-success')!;
  const error = document.getElementById('form-error')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btnText.textContent = 'Sending...';
    btnIcon.classList.add('hidden');
    btnSpinner.classList.remove('hidden');
    success.classList.add('hidden');
    error.classList.add('hidden');

    try {
      const res = await fetch(`${apiBase}/api/contact`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });

      if (res.ok) {
        success.classList.remove('hidden');
        form.reset();
      } else {
        error.classList.remove('hidden');
      }
    } catch {
      error.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btnText.textContent = 'Send Message';
      btnIcon.classList.remove('hidden');
      btnSpinner.classList.add('hidden');
    }
  });
</script>
