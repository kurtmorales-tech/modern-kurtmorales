---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Templates from '../components/sections/Templates.astro';
import { getTemplates } from '../lib/payload';
import { fallbackTemplates } from '../data/fallback';

const cmsTemplates = await getTemplates();
const templates = cmsTemplates.length > 0 ? cmsTemplates : fallbackTemplates;
---

<BaseLayout
  title="Website Templates | KurtMorales"
  description="Ready-to-use website templates for startups, SaaS, ecommerce, and portfolios. Built with modern tech stack."
  canonical="/templates"
>
  <Header />
  <main id="main-content" class="pt-24">
    <Templates templates={templates} showBrowseLink={false} />
  </main>
  <Footer />
</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('revealed');
        observer.unobserve(entry.target);
      }
    }),
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' },
  );

  document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale').forEach((el) => observer.observe(el));
</script>
