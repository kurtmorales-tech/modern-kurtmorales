---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="About — KurtMorales"
  description="Kurt Anthony Morales — Las Vegas freelance web designer and developer building clean, fast websites for small businesses and service providers."
>
  <Header />
  <main id="main-content">

    <!-- Hero -->
    <section class="pt-32 pb-24 border-b border-gray-100">
      <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-[1.2fr_0.8fr] gap-20 items-start">
        <div>
          <span class="text-gray-400 font-bold text-[10px] tracking-widest uppercase block mb-6 reveal">About</span>
          <h1 class="text-4xl md:text-[4.5rem] font-display font-medium leading-[0.92] tracking-tight mb-8 text-brand reveal" style="transition-delay:100ms">
            Building the web,<br/>one pixel at a time.
          </h1>
          <p class="text-gray-500 text-lg leading-relaxed max-w-xl reveal" style="transition-delay:200ms">
            I'm Kurt Anthony Morales — a freelance web designer and developer based in Las Vegas, NV.
            I specialize in building clean, fast, conversion-focused websites for small businesses, service providers, and startups.
          </p>
        </div>
        <div class="reveal-right border border-gray-200 p-10 bg-white/80 backdrop-blur-sm relative">
          <div class="absolute top-0 left-0 w-12 h-[2px] bg-brand"></div>
          <div class="absolute top-0 left-0 w-[2px] h-12 bg-brand"></div>
          <div class="flex items-center gap-3 mb-6">
            <span class="w-2 h-2 bg-green-500 rounded-full pulse-dot"></span>
            <span class="text-[10px] font-black uppercase tracking-widest">Available for Projects</span>
          </div>
          <ul class="space-y-4 text-sm text-gray-500">
            <li>📍 Las Vegas, Nevada</li>
            <li>💼 Freelance since 2025</li>
            <li>🌐 Remote-first, globally active</li>
            <li>⚡ Cloudflare &amp; Vercel deployment</li>
            <li>🎓 Google &amp; Microsoft certified</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Story -->
    <section class="py-24 border-b border-gray-100 bg-white">
      <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-[0.8fr_1.2fr] gap-20 items-start">
        <div class="reveal-left">
          <span class="text-gray-400 font-bold text-[10px] tracking-widest uppercase block mb-4">My Story</span>
          <h2 class="text-3xl md:text-5xl font-display font-medium leading-tight text-brand">From side projects to client work.</h2>
        </div>
        <div class="space-y-6 text-gray-500 leading-relaxed reveal">
          <p>
            I started building for the web out of necessity — I wanted things to exist that didn't. That curiosity turned into a skill set,
            and that skill set turned into a studio.
          </p>
          <p>
            Today, I work with local businesses and founders to build websites that actually perform. Not just visually — but in search rankings,
            load times, and conversion rates. Every project I take on has a clear purpose: help the business grow online.
          </p>
          <p>
            My approach is simple: listen first, build second. Clean code, modern stack, and zero bloat. I believe in shipping fast and
            iterating based on real data — not assumptions.
          </p>
          <p>
            When I'm not building, I'm learning. Google certifications, Microsoft Learn, open-source contributions, and staying current
            with the evolving AI tooling landscape.
          </p>
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="py-24 border-b border-gray-100">
      <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-2xl mb-16 reveal-left">
          <span class="text-gray-400 font-bold text-[10px] tracking-widest uppercase block mb-4">Principles</span>
          <h2 class="text-3xl md:text-5xl font-display font-medium leading-tight text-brand">How I work.</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {[
            { num: '01', title: 'Clarity over complexity', body: "Simple, readable code and simple UIs. If it takes 10 lines, it shouldn't take 100. Every element on a page earns its place." },
            { num: '02', title: 'Speed is a feature', body: "Sub-second load times aren't optional — they're the standard. I optimize for performance from day one, not as an afterthought." },
            { num: '03', title: 'Own what you ship', body: "I stay with projects after launch. Bug fixes, CMS training, performance monitoring — I treat client sites like they're my own." },
          ].map((v, i) => (
            <article class="reveal group relative bg-white border border-gray-100 p-10 card-lift overflow-hidden" style={`transition-delay:${i*120}ms`}>
              <span class="absolute -top-4 -right-2 text-[8rem] font-display font-bold text-gray-50 leading-none select-none group-hover:text-brand/5 transition-colors duration-500">{v.num}</span>
              <div class="relative z-10">
                <h3 class="text-xl font-bold mb-4 text-black tracking-tight group-hover:text-brand transition-colors duration-300">{v.title}</h3>
                <p class="text-gray-500 leading-relaxed text-sm">{v.body}</p>
                <div class="mt-8 h-[2px] w-0 bg-brand group-hover:w-full transition-all duration-500 ease-out"></div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Credentials -->
    <section class="py-24 bg-white border-b border-gray-100">
      <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-2xl mb-16 reveal-left">
          <span class="text-gray-400 font-bold text-[10px] tracking-widest uppercase block mb-4">Credentials</span>
          <h2 class="text-3xl md:text-5xl font-display font-medium leading-tight text-brand">Certifications & learning.</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          {[
            { org: 'Google', label: 'Google Developer Profile', url: 'https://developers.google.com/profile/u/kurtmorales-developer', badge: '🔵' },
            { org: 'Google', label: 'Google Skills Boost', url: 'https://www.skills.google/public_profiles/e568df3b', badge: '🟢' },
            { org: 'Microsoft', label: 'Microsoft Learn', url: 'https://learn.microsoft.com/', badge: '🟦' },
            { org: 'GitHub', label: 'Open Source — kurtmorales-tech', url: 'https://github.com/kurtmorales-tech', badge: '⚫' },
          ].map((c, i) => (
            <a href={c.url} target="_blank" rel="noreferrer"
              class="reveal group flex items-center gap-6 p-8 bg-white border border-gray-100 card-lift"
              style={`transition-delay:${i*80}ms`}>
              <span class="text-2xl">{c.badge}</span>
              <div>
                <p class="text-[9px] font-black uppercase tracking-widest text-gray-400 mb-1">{c.org}</p>
                <p class="font-bold text-black group-hover:text-brand transition-colors">{c.label}</p>
              </div>
              <svg class="w-4 h-4 text-gray-200 group-hover:text-brand ml-auto transition-all duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/></svg>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-32 bg-gray-950 text-white text-center relative overflow-hidden">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-brand/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="max-w-4xl mx-auto px-6 relative z-10">
        <h2 class="reveal text-4xl md:text-6xl font-display font-medium leading-tight mb-8">
          Ready to start a project?
        </h2>
        <p class="reveal text-gray-400 text-lg max-w-xl mx-auto mb-12 leading-relaxed" style="transition-delay:100ms">
          Let's talk about your goals, timeline, and how I can help your business grow online.
        </p>
        <div class="reveal flex flex-wrap justify-center gap-4" style="transition-delay:200ms">
          <a href="mailto:email@kurtmorales.com" class="group inline-flex items-center gap-3 px-10 py-5 bg-brand text-white font-bold hover:bg-brand-light transition-all duration-300">
            Start a Conversation
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/></svg>
          </a>
          <a href="/#projects" class="inline-flex items-center gap-3 px-10 py-5 border border-white/20 text-white font-bold hover:bg-white/10 transition-all duration-300">
            View My Work
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => { entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); observer.unobserve(e.target); } }); },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => observer.observe(el));
</script>
