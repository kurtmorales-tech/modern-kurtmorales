---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getPosts } from '../../../lib/payload';
import { fallbackPosts } from '../../../data/fallback';

const cmsPosts = await getPosts();
const posts = cmsPosts.length > 0 ? cmsPosts : fallbackPosts;
---
<BaseLayout
  title="Blog Studio — KurtMorales"
  description="Edit blog posts in the browser through the Cloudflare Worker studio."
  canonical="/studio/blog"
  noindex={true}
>
  <Header />
  <main id="main-content" class="pt-12 pb-32">
    <section class="mx-auto max-w-6xl px-6 space-y-8">
      <div class="km-panel rounded-[2rem] p-8 md:p-10 space-y-4">
        <p class="text-[10px] font-black uppercase tracking-[0.3em] text-brand">Editor Index</p>
        <h1 class="text-4xl md:text-5xl font-display font-medium text-[var(--km-text-strong)]">Blog Studio</h1>
        <p class="max-w-3xl text-base leading-7 text-[var(--km-muted)]">
          Open any article in the browser editor, load its Worker draft, and save changes into Cloudflare D1 before the next rebuild.
        </p>
      </div>

      <section class="km-panel rounded-[2rem] p-8 md:p-10 space-y-5" data-content-generator>
        <div class="space-y-2">
          <p class="text-[10px] font-black uppercase tracking-[0.3em] text-brand">Admin Actions</p>
          <h2 class="text-2xl font-display font-medium text-[var(--km-text-strong)]">Generate RSS Drafts</h2>
          <p class="max-w-3xl text-sm leading-6 text-[var(--km-muted)]">
            Trigger the protected Worker route to fetch relevant RSS posts and save new draft entries into Cloudflare D1.
          </p>
        </div>

        <form class="grid gap-4 lg:grid-cols-[minmax(0,1.3fr)_180px_auto] lg:items-end" data-content-generator-form>
          <label class="space-y-2">
            <span class="text-[10px] font-black uppercase tracking-[0.28em] text-[var(--km-muted)]">Admin Token</span>
            <input
              class="w-full rounded-2xl border border-[var(--km-border)] bg-[var(--km-surface)] px-4 py-3 text-sm text-[var(--km-text-strong)] outline-none transition focus:border-brand"
              type="password"
              name="token"
              placeholder="Enter ADMIN_SECRET"
              autocomplete="off"
            />
          </label>
          <label class="space-y-2">
            <span class="text-[10px] font-black uppercase tracking-[0.28em] text-[var(--km-muted)]">Source</span>
            <input
              class="w-full rounded-2xl border border-[var(--km-border)] bg-[var(--km-surface)] px-4 py-3 text-sm text-[var(--km-text-strong)] outline-none transition focus:border-brand"
              type="text"
              name="source"
              placeholder="all or cloudflare"
            />
          </label>
          <label class="space-y-2">
            <span class="text-[10px] font-black uppercase tracking-[0.28em] text-[var(--km-muted)]">Limit</span>
            <input
              class="w-full rounded-2xl border border-[var(--km-border)] bg-[var(--km-surface)] px-4 py-3 text-sm text-[var(--km-text-strong)] outline-none transition focus:border-brand"
              type="number"
              name="limit"
              min="1"
              max="10"
              value="1"
            />
          </label>
          <div class="lg:col-span-3 flex flex-wrap items-center gap-3">
            <button type="submit" class="km-button km-button-primary" data-content-generator-submit>Generate Content</button>
            <p class="text-sm text-[var(--km-muted)]" data-content-generator-message>
              Enter the admin token to create RSS-backed draft posts.
            </p>
          </div>
        </form>

        <pre class="overflow-x-auto rounded-[1.5rem] border border-[var(--km-border)] bg-[var(--km-surface-muted)] px-4 py-4 text-xs leading-6 text-[var(--km-muted)] whitespace-pre-wrap" data-content-generator-result>Waiting for a generation request.</pre>
      </section>

      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {posts.map((post) => (
          <article class="km-panel rounded-[2rem] p-6 space-y-4" data-live-card>
            <div class="flex items-center justify-between gap-3">
              <span class="km-pill text-[10px] font-black uppercase tracking-[0.24em] text-[var(--km-muted)]">{post.status}</span>
              <span class="text-[10px] font-black uppercase tracking-[0.24em] text-[var(--km-muted-soft)]">{post.readTime ?? 'editor ready'}</span>
            </div>
            <div class="space-y-3">
              <h2 class="text-2xl font-display text-[var(--km-text-strong)]">{post.title}</h2>
              <p class="text-sm leading-6 text-[var(--km-muted)]">{post.excerpt}</p>
            </div>
            <div class="flex flex-wrap gap-2">
              {post.tags?.map((tag) => (
                <span class="km-pill text-[10px] font-black uppercase tracking-[0.22em] text-[var(--km-muted)]">{tag.tag}</span>
              ))}
            </div>
            <div class="flex flex-wrap gap-3 pt-2">
              <a href={`/studio/blog/${post.slug}`} class="km-button km-button-primary">Edit Post</a>
              <a href={`/blog/${post.slug}`} class="km-button km-button-secondary">View Live</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const root = document.querySelector('[data-content-generator]');

  if (root instanceof HTMLElement) {
    const form = root.querySelector('[data-content-generator-form]');
    const message = root.querySelector('[data-content-generator-message]');
    const result = root.querySelector('[data-content-generator-result]');
    const submit = root.querySelector('[data-content-generator-submit]');
    const tokenKey = 'km-admin-secret';

    if (
      form instanceof HTMLFormElement &&
      message instanceof HTMLElement &&
      result instanceof HTMLElement &&
      submit instanceof HTMLButtonElement
    ) {
      const tokenInput = form.elements.namedItem('token');

      if (tokenInput instanceof HTMLInputElement) {
        tokenInput.value = localStorage.getItem(tokenKey) ?? '';
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const data = new FormData(form);
        const token = String(data.get('token') ?? '').trim();
        const source = String(data.get('source') ?? '').trim();
        const limitValue = Number(data.get('limit') ?? 1);

        if (!token) {
          message.textContent = 'Enter the admin token first.';
          return;
        }

        localStorage.setItem(tokenKey, token);
        submit.disabled = true;
        message.textContent = 'Generating content...';
        result.textContent = 'Running /api/content/generate ...';

        try {
          const response = await fetch('/api/content/generate', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({
              source: source || undefined,
              limit: Number.isFinite(limitValue) ? limitValue : 1,
            }),
          });

          const payload = await response.json().catch(() => ({ error: 'Unable to parse response.' }));
          result.textContent = JSON.stringify(payload, null, 2);
          message.textContent = response.ok
            ? `Generation completed. Saved ${payload.saved ?? 0} draft(s).`
            : payload.error ?? 'Generation failed.';
        } catch (error) {
          message.textContent = 'Generation request failed.';
          result.textContent = error instanceof Error ? error.message : String(error);
        } finally {
          submit.disabled = false;
        }
      });
    }
  }
</script>
