---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Metrics from '../components/sections/Metrics.astro';
import Services from '../components/sections/Services.astro';
import Projects from '../components/sections/Projects.astro';
import Skills from '../components/sections/Skills.astro';
import DigitalFootprint from '../components/sections/DigitalFootprint.astro';
import { getProjects } from '../lib/payload';
import { fallbackProjects } from '../data/fallback';

const cmsProjects = await getProjects();
const projects = cmsProjects.length > 0 ? cmsProjects : fallbackProjects;
---
<BaseLayout title="KurtMorales — Web Design & Development">
  <Header />
  <main>
    <Hero />
    <Metrics />
    <Services />
    <Projects projects={projects} />
    <Skills />
    <DigitalFootprint />
    <section id="contact" class="py-32 border-t border-gray-100">
      <div class="max-w-6xl mx-auto px-6 text-center">
        <span class="text-gray-400 font-bold text-[10px] tracking-widest uppercase block mb-6">Get in Touch</span>
        <h2 class="text-4xl md:text-6xl font-display font-medium leading-tight text-brand mb-8">
          Let's build something great.
        </h2>
        <p class="text-gray-500 text-lg max-w-xl mx-auto mb-12 leading-relaxed">
          Ready to start a project? Reach out and let's discuss how I can help grow your online presence.
        </p>
        <a href="mailto:email@kurtmorales.com" class="inline-flex items-center gap-3 px-10 py-5 bg-brand text-white font-bold hover:opacity-90 transition-all active:scale-95">
          Start a Conversation
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
