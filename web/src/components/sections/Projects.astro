---
import type { PayloadProject } from '../../lib/payload';
interface Props {
  projects: PayloadProject[];
}
const { projects } = Astro.props;
---
<section id="projects" class="py-32 bg-ice border-y border-gray-100">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mb-24">
      <span class="text-gray-400 font-bold text-[10px] tracking-widest uppercase block mb-6">Portfolio</span>
      <h2 class="text-4xl md:text-6xl font-display font-medium leading-tight text-brand text-pretty">
        Selected works and digital experiments.
      </h2>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-gray-200 border border-gray-200 overflow-hidden">
      {projects.map((p) => (
        <article class="flex flex-col bg-white p-12 hover:bg-gray-50 transition-colors">
          <div class="flex justify-between items-start mb-12">
            <span class="text-[9px] font-black uppercase tracking-widest text-gray-400">{p.type}</span>
            <span class="text-[9px] font-black uppercase tracking-widest text-black">{p.tech}</span>
          </div>
          <h3 class="text-xl font-bold mb-4 text-black tracking-tight">{p.title}</h3>
          <p class="text-gray-500 text-sm leading-relaxed mb-12 flex-grow">{p.description}</p>
          <a
            href={p.link}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-black hover:opacity-100 opacity-60 transition-opacity"
          >
            Explore Repository
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/></svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
