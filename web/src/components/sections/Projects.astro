---
import type { PayloadProject } from '../../lib/payload';
interface Props {
  projects: PayloadProject[];
}
const { projects } = Astro.props;
---
<section id="projects" class="py-32 bg-surface-alt border-y border-gray-100">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mb-24 reveal-left">
      <span class="text-gray-400 font-bold text-[10px] tracking-widest uppercase block mb-6">Portfolio</span>
      <h2 class="text-4xl md:text-6xl font-display font-medium leading-tight text-brand text-pretty">
        Selected works and digital experiments.
      </h2>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {projects.map((p, i) => (
        <a
          href={p.link}
          target="_blank"
          rel="noreferrer"
          class="reveal group relative bg-white border border-gray-100 p-10 card-lift block overflow-hidden"
          style={`transition-delay: ${i * 80}ms`}
        >
          <!-- Project number -->
          <span class="absolute top-6 right-6 text-[10px] font-black text-gray-200 tabular-nums group-hover:text-brand/40 transition-colors duration-300">
            {String(i + 1).padStart(2, '0')}
          </span>

          <div class="flex flex-col h-full relative z-10">
            <div class="flex items-center gap-3 mb-8">
              <span class="text-[9px] font-black uppercase tracking-widest text-gray-400 bg-gray-50 px-3 py-1.5 group-hover:bg-brand/5 group-hover:text-brand/70 transition-all duration-300">{p.type}</span>
              <span class="text-[9px] font-black uppercase tracking-widest text-brand/50">{p.tech}</span>
            </div>

            <h3 class="text-xl font-bold mb-3 text-black tracking-tight group-hover:text-brand transition-colors duration-300">{p.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed mb-8 flex-grow">{p.description}</p>

            <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-gray-300 group-hover:text-brand transition-all duration-300">
              <span>View Project</span>
              <svg class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/></svg>
            </div>
          </div>

          <!-- Bottom border accent on hover -->
          <div class="absolute bottom-0 left-0 right-0 h-[2px] bg-brand scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
        </a>
      ))}
    </div>
  </div>
</section>
