---
import type { Template } from '../../lib/payload';
interface Props {
  templates: Template[];
  showBrowseLink?: boolean;
}
const { templates, showBrowseLink = true } = Astro.props;
---

<section id="templates" class="py-32 bg-white border-y border-gray-100">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mb-24 reveal-left">
      <span class="text-gray-400 font-bold text-[10px] tracking-widest uppercase block mb-6">Templates</span>
      <h2 class="text-4xl md:text-6xl font-display font-medium leading-tight text-brand text-pretty">
        Ready-to-use website templates.
      </h2>
      <p class="mt-6 text-gray-500 leading-relaxed">
        Professionally designed templates to kickstart your next project. Dynamic previews, clean code, and full documentation included.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {templates.map((t, i) => (
        <div
          class="reveal group relative bg-white border border-gray-100 overflow-hidden card-lift"
          style={`transition-delay: ${i * 80}ms`}
        >
          <!-- Featured badge -->
          {t.featured && (
            <span class="absolute top-4 right-4 z-10 text-[9px] font-black uppercase tracking-widest bg-brand text-white px-3 py-1.5">
              Featured
            </span>
          )}

          <!-- Thumbnail -->
          <div class="aspect-[4/3] overflow-hidden bg-gray-50">
            {t.thumbnail && typeof t.thumbnail === 'object' && 'url' in t.thumbnail ? (
              <img
                src={typeof t.thumbnail.url === 'string' ? t.thumbnail.url : ''}
                alt={t.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-gray-300 text-sm">
                No preview
              </div>
            )}
          </div>

          <div class="p-8">
            <div class="flex items-center gap-3 mb-4">
              {t.tech && (
                <span class="text-[9px] font-black uppercase tracking-widest text-gray-400 bg-gray-50 px-3 py-1.5">
                  {t.tech}
                </span>
              )}
              {t.price !== undefined && (
                <span class="text-[9px] font-black uppercase tracking-widest text-brand/70">
                  {t.price === 0 ? 'Free' : `$${t.price}`}
                </span>
              )}
            </div>

            <h3 class="text-xl font-bold mb-3 text-black tracking-tight group-hover:text-brand transition-colors duration-300">
              {t.title}
            </h3>
            <p class="text-gray-500 text-sm leading-relaxed mb-6 line-clamp-3">
              {t.description}
            </p>

            <div class="flex items-center gap-4">
              {t.demoUrl && (
                <a
                  href={t.demoUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="text-[10px] font-black uppercase tracking-widest text-brand hover:text-brand-dark transition-colors duration-300 flex items-center gap-2"
                >
                  Live Demo
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/></svg>
                </a>
              )}
              {t.sourceUrl && (
                <a
                  href={t.sourceUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="text-[10px] font-black uppercase tracking-widest text-gray-400 hover:text-brand transition-colors duration-300"
                >
                  Source
                </a>
              )}
            </div>
          </div>

          <!-- Bottom border accent on hover -->
          <div class="absolute bottom-0 left-0 right-0 h-[2px] bg-brand scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
        </div>
      ))}
    </div>

    <!-- View all link -->
    {showBrowseLink && (
      <div class="text-center mt-16">
        <a href="/templates" class="inline-flex items-center gap-3 px-10 py-5 border border-brand text-brand font-bold hover:bg-brand hover:text-white transition-all duration-300 active:scale-[0.97]">
          Browse All Templates
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </a>
      </div>
    )}
  </div>
</section>
