---
---
<section id="home" class="relative pt-32 pb-40 border-b border-gray-100">
  <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-[1.2fr_0.8fr] gap-20 items-center">
    <div>
      <span class="inline-block text-[10px] font-black tracking-[0.3em] uppercase mb-8 text-gray-400">
        Web Design & Development
      </span>
      <h1 class="text-5xl md:text-8xl font-display font-medium leading-[0.95] tracking-tight mb-10 text-brand">
        Purposeful design.<br/>Fast performance.
      </h1>
      <p class="text-lg md:text-xl text-gray-500 mb-12 max-w-xl leading-relaxed">
        KurtMorales builds high-performance web experiences that focus on clarity, conversion, and long-term business growth.
      </p>
      <div class="flex flex-col gap-6">
        <div class="flex flex-wrap gap-4">
          <a href="mailto:email@kurtmorales.com" class="px-10 py-5 bg-brand text-white font-bold flex items-center gap-3 hover:opacity-90 transition-all active:scale-95">
            Let's Talk Projects
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/></svg>
          </a>
          <a href="#projects" class="px-10 py-5 border border-brand text-brand font-bold hover:bg-brand hover:text-white transition-all active:scale-95">
            Explore Portfolio
          </a>
        </div>
        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-400">
          Preferred contact: Email or Social Media
        </p>
      </div>
    </div>

    <div class="border border-gray-900 p-10 relative bg-white">
      <div class="flex items-center gap-3 mb-8">
        <span class="w-2 h-2 bg-black"></span>
        <span class="text-[10px] font-black uppercase tracking-widest text-gray-900">Current Availability</span>
      </div>
      <h2 class="text-2xl font-display font-medium mb-8 leading-tight">Delivering clean solutions for local & global businesses.</h2>
      <ul class="space-y-5 text-sm text-gray-500">
        {['Las Vegas based, globally active', 'Cloudflare & Vercel deployment', 'Modern TypeScript architecture', 'User-centric interface design'].map((item) => (
          <li class="flex items-start gap-4">
            <span class="mt-1 w-1.5 h-1.5 border border-gray-300 flex-shrink-0"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
