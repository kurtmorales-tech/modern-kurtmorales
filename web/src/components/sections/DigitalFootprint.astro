---
const platforms = [
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/kurtanthonymorales/', icon: 'linkedin' },
  { name: 'GitHub', url: 'https://github.com/kurtmorales-tech', icon: 'github' },
  { name: 'Google Dev', url: 'https://developers.google.com/profile/u/kurtmorales-developer', icon: 'globe' },
  { name: 'Google Skills', url: 'https://www.skills.google/public_profiles/e568df3b', icon: 'shield' },
  { name: 'MS Learn', url: 'https://learn.microsoft.com/', icon: 'cloud' },
  { name: 'Facebook', url: 'https://www.facebook.com/kamhypeofficial', icon: 'facebook' },
  { name: 'X', url: 'https://x.com/xkamhype', icon: 'twitter' },
];
---
<section class="py-32 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mb-24 reveal-left">
      <span class="text-gray-400 font-bold text-[10px] tracking-widest uppercase block mb-6">Network</span>
      <h2 class="text-4xl md:text-6xl font-display font-medium leading-tight text-brand">
        Presence across platforms.
      </h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3">
      {platforms.map((link, i) => (
        <a
          href={link.url}
          target="_blank"
          rel="noreferrer"
          class="reveal flex flex-col items-center justify-center p-8 bg-white border border-gray-100 group card-lift text-center"
          style={`transition-delay: ${i * 60}ms`}
        >
          <div class="mb-5 text-gray-300 group-hover:text-brand transition-all duration-300 group-hover:scale-110">
            {link.icon === 'linkedin' && (
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            )}
            {link.icon === 'github' && (
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            )}
            {link.icon === 'globe' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
            )}
            {link.icon === 'shield' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            )}
            {link.icon === 'cloud' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M18 10h-1.26A8 8 0 109 20h9a5 5 0 000-10z"/></svg>
            )}
            {link.icon === 'facebook' && (
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            )}
            {link.icon === 'twitter' && (
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            )}
          </div>
          <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest group-hover:text-brand/80 transition-colors duration-300">{link.name}</span>
        </a>
      ))}
    </div>
  </div>
</section>
