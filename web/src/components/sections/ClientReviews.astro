---
// Replace these placeholder cards with real client testimonials before publishing.
const reviews = [
  {
    label: 'Fast turnaround',
    quote: 'Swap this with a real client quote about speed, clarity, or delivery. The carousel is built and ready for production copy.',
    name: 'Client Name',
    role: 'Business / Role',
  },
  {
    label: 'Clear process',
    quote: 'Use this card for feedback about communication, clean handoff, or how smooth the project felt from start to launch.',
    name: 'Client Name',
    role: 'Founder / Owner',
  },
  {
    label: 'Better results',
    quote: 'Drop in a short review that highlights stronger conversions, a cleaner brand presence, or a faster website experience.',
    name: 'Client Name',
    role: 'Marketing Lead',
  },
  {
    label: 'Reliable partner',
    quote: 'This slide works well for trust-based feedback: dependable timelines, quick revisions, and confidence after launch.',
    name: 'Client Name',
    role: 'Startup Team',
  },
  {
    label: 'Modern build',
    quote: 'Use one review to mention the polished design, mobile responsiveness, and overall quality of the finished site.',
    name: 'Client Name',
    role: 'Creative Brand',
  },
];
---
<section id="reviews" class="py-32 bg-white border-y border-gray-100 overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mb-16 reveal-left">
      <span class="text-gray-400 font-bold text-[10px] tracking-widest uppercase block mb-6">Client Reviews</span>
      <h2 class="text-4xl md:text-6xl font-display font-medium leading-tight text-brand text-pretty">
        Fast-moving social proof.
      </h2>
      <p class="text-gray-500 text-lg leading-relaxed mt-6">
        Auto-sliding review cards. Hover to pause. Replace the starter copy with real testimonials anytime.
      </p>
    </div>

    <div class="reviews-shell reveal relative overflow-hidden">
      <div class="reviews-fade reviews-fade-left" aria-hidden="true"></div>
      <div class="reviews-fade reviews-fade-right" aria-hidden="true"></div>

      <div class="reviews-marquee">
        {[0, 1].map((duplicate) => (
          <div class="reviews-group" aria-hidden={duplicate === 1 ? 'true' : undefined}>
            {reviews.map((review) => (
              <article class="w-[19rem] md:w-[22rem] flex-shrink-0 bg-white border border-gray-100 p-8 card-lift">
                <div class="flex items-center justify-between gap-4 mb-6">
                  <span class="text-[10px] font-black uppercase tracking-widest text-gray-400">{review.label}</span>
                  <div class="flex items-center gap-1 text-brand" aria-label="5 star review">
                    {Array.from({ length: 5 }).map(() => (
                      <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.538 1.118l-2.8-2.034a1 1 0 00-1.176 0l-2.8 2.034c-.783.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.363-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81H7.03a1 1 0 00.951-.69l1.069-3.292z" />
                      </svg>
                    ))}
                  </div>
                </div>

                <p class="text-base leading-relaxed text-gray-600 mb-8">
                  “{review.quote}”
                </p>

                <div class="pt-6 border-t border-gray-100">
                  <p class="text-sm font-bold text-black">{review.name}</p>
                  <p class="text-[11px] uppercase tracking-[0.24em] text-gray-400 mt-2">{review.role}</p>
                </div>
              </article>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-shell:hover .reviews-marquee {
    animation-play-state: paused;
  }

  .reviews-marquee {
    display: flex;
    width: max-content;
    animation: client-review-slide 12s linear infinite;
    will-change: transform;
  }

  .reviews-group {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
    padding-right: 1rem;
  }

  .reviews-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 5rem;
    z-index: 2;
    pointer-events: none;
  }

  .reviews-fade-left {
    left: 0;
    background: linear-gradient(90deg, var(--km-surface) 0%, transparent 100%);
  }

  .reviews-fade-right {
    right: 0;
    background: linear-gradient(270deg, var(--km-surface) 0%, transparent 100%);
  }

  @keyframes client-review-slide {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews-marquee {
      animation: none;
      width: 100%;
    }

    .reviews-group {
      flex-wrap: wrap;
      padding-right: 0;
    }

    .reviews-fade {
      display: none;
    }
  }
</style>
