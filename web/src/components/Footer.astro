---
const year = new Date().getFullYear();
---
<footer class="border-t border-gray-100 km-glass py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid gap-6 md:grid-cols-[1.35fr_1fr_1fr] items-start">
      <div class="km-panel live-card rounded-[2rem] p-8 md:p-10" data-live-card>
        <a href="/" class="text-2xl font-bold tracking-tight mb-6 inline-flex items-center gap-3 group km-text-strong">
          <span class="inline-flex h-3 w-3 rounded-full bg-brand/80 shadow-[0_0_0_6px_rgba(244,129,32,0.12)]"></span>
          Kurt<span class="text-brand group-hover:text-brand-dark transition-colors duration-300">Morales</span>
        </a>
        <p class="text-sm km-text-muted max-w-sm leading-relaxed mb-8">
          Cloudflare-ready websites, sharp content systems, and conversion-focused interfaces built for real business use.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="mailto:email@kurtmorales.com" class="km-button km-button-secondary">Email</a>
          <a href="/contact" class="km-button km-button-primary">Start project</a>
        </div>
      </div>

      <div class="km-panel live-card rounded-[2rem] p-8 md:p-10" data-live-card>
        <span class="text-[10px] font-black uppercase tracking-[0.28em] km-text-soft block mb-6">Navigation</span>
        <ul class="space-y-4 text-sm km-text-muted font-medium">
          <li><a href="/#services" class="link-underline hover:text-brand transition-colors duration-300">Services</a></li>
          <li><a href="/#projects" class="link-underline hover:text-brand transition-colors duration-300">Projects</a></li>
          <li><a href="/about" class="link-underline hover:text-brand transition-colors duration-300">About</a></li>
          <li><a href="/blog" class="link-underline hover:text-brand transition-colors duration-300">Blog</a></li>
          <li><a href="/templates" class="link-underline hover:text-brand transition-colors duration-300">Templates</a></li>
          <li><a href="/products" class="link-underline hover:text-brand transition-colors duration-300">Products</a></li>
          <li><a href="/resources" class="link-underline hover:text-brand transition-colors duration-300">Resources</a></li>
          <li><a href="/contact" class="link-underline hover:text-brand transition-colors duration-300">Contact</a></li>
        </ul>
      </div>

      <div class="km-panel live-card rounded-[2rem] p-8 md:p-10" data-live-card>
        <span class="text-[10px] font-black uppercase tracking-[0.28em] km-text-soft block mb-6">Legal & Meta</span>
        <ul class="space-y-4 text-sm km-text-muted font-medium">
          <li><a href="mailto:email@kurtmorales.com" class="link-underline hover:text-brand transition-colors duration-300">Admin Support</a></li>
          <li><a href="/privacy" class="link-underline hover:text-brand transition-colors duration-300">Privacy Policy</a></li>
          <li><a href="/terms" class="link-underline hover:text-brand transition-colors duration-300">Terms of Service</a></li>
          <li><a href="https://github.com/kurtmorales-tech" target="_blank" rel="noreferrer" class="link-underline hover:text-brand transition-colors duration-300">System Status</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-8 border-t border-gray-100 flex flex-col md:flex-row justify-between items-center gap-6">
      <p class="text-[10px] font-black uppercase tracking-[0.24em] km-text-soft">© {year} KurtMorales Studio. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-3">
        <a href="https://github.com/kurtmorales-tech" target="_blank" rel="noreferrer" class="km-pill km-text-muted hover:text-brand transition-colors duration-300" aria-label="GitHub">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          <span class="text-[10px] font-black uppercase tracking-[0.2em]">GitHub</span>
        </a>
        <a href="https://www.linkedin.com/in/kurtanthonymorales/" target="_blank" rel="noreferrer" class="km-pill km-text-muted hover:text-brand transition-colors duration-300" aria-label="LinkedIn">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          <span class="text-[10px] font-black uppercase tracking-[0.2em]">LinkedIn</span>
        </a>
        <a href="https://x.com/xkamhype" target="_blank" rel="noreferrer" class="km-pill km-text-muted hover:text-brand transition-colors duration-300" aria-label="X">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          <span class="text-[10px] font-black uppercase tracking-[0.2em]">X</span>
        </a>
      </div>
    </div>
  </div>
</footer>
