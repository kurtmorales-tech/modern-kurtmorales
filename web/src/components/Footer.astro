---
const year = new Date().getFullYear();
---
<footer class="bg-white text-black py-32 border-t border-gray-100">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid md:grid-cols-[1.5fr_1fr_1fr] gap-20 items-start">
      <div class="reveal">
        <a href="/" class="text-2xl font-bold tracking-tight mb-8 block group">Kurt<span class="text-brand group-hover:text-brand-dark transition-colors duration-300">Morales</span></a>
        <p class="text-sm text-gray-500 max-w-xs leading-relaxed">Professional web solutions for service providers. Building clarity and performance into every pixel.</p>
      </div>
      <div class="reveal" style="transition-delay:100ms">
        <span class="text-[10px] font-black uppercase tracking-widest text-black block mb-6">Navigation</span>
        <ul class="space-y-4 text-sm text-gray-500 font-medium">
          <li><a href="/#services" class="link-underline hover:text-black transition-colors duration-300">Services</a></li>
          <li><a href="/#projects" class="link-underline hover:text-black transition-colors duration-300">Projects</a></li>
          <li><a href="/about" class="link-underline hover:text-black transition-colors duration-300">About</a></li>
          <li><a href="/blog" class="link-underline hover:text-black transition-colors duration-300">Blog</a></li>
          <li><a href="/contact" class="link-underline hover:text-black transition-colors duration-300">Contact</a></li>
        </ul>
      </div>
      <div class="reveal" style="transition-delay:200ms">
        <span class="text-[10px] font-black uppercase tracking-widest text-black block mb-6">Legal & Meta</span>
        <ul class="space-y-4 text-sm text-gray-500 font-medium">
          <li><a href="mailto:email@kurtmorales.com" class="link-underline hover:text-black transition-colors duration-300">Admin Support</a></li>
          <li><a href="/privacy" class="link-underline hover:text-black transition-colors duration-300">Privacy Policy</a></li>
          <li><a href="/terms" class="link-underline hover:text-black transition-colors duration-300">Terms of Service</a></li>
          <li><a href="https://github.com/kurtmorales-tech" target="_blank" rel="noreferrer" class="link-underline hover:text-black transition-colors duration-300">System Status</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-32 pt-12 border-t border-gray-100 flex flex-col md:flex-row justify-between items-center gap-8">
      <p class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-400">© {year} KurtMorales Studio. All rights reserved.</p>
      <div class="flex gap-8">
